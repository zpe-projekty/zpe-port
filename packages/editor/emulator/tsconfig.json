{
    "include": [
        "**/*",
        "custom.d.ts"
    ],
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "declaration": false,
        "sourceMap": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "rootDir": "./src",
        "paths": {
            "~/*": [
                "./src/*"
            ],
            "@/*": [
                "./packages/*"
            ]
        }
    }
}