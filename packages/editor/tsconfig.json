{
    "include": [
        "**/*",
        "emulator/**/*",
        "packages/duct-tape/**/*",
    ],
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "declaration": false,
        "sourceMap": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "./build",
        "rootDirs": [
            "./src",
            "./emulator/build",
        ],
        "paths": {
            "~/*": [
                "./src/*"
            ],
            "@/*": [
                "./packages/*"
            ]
        }
    }
}