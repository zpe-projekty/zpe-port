{
    "definitions": {
        "styles": {
            "classic": "Klasyczny",
            "modern": "Nowoczesny",
            "retro": "Retro"
        }
    },
    "properties": {
        "options": {
            "type": "object",
            "title": "Opcje",
            "properties": {
                "enableHints": {
                    "type": "boolean",
                    "label": "Włącz podpowiedzi do rebusów"
                },
                "enableTimer": {
                    "type": "boolean",
                    "label": "Włącz timer"
                },
                "playTime": {
                    "type": "number",
                    "format": "integer",
                    "min": 1,
                    "max": 10000,
                    "label": "Całkowity czas gry (w minutach)"
                },
                "numberOfRebusesToSolve": {
                    "type": "number",
                    "format": "integer",
                    "min": 1,
                    "label": "Liczba rebusów do rozwiązania"
                },
                "mode": {
                    "type": "string",
                    "enum": {
                        "easy": "łatwy",
                        "medium": "średni",
                        "hard": "trudny"
                    },
                    "label": "Tryb",
                    "help": "Wybierz tryb gry. 'łatwy' - podpowiedzi do rebusów, 'średni' - bez podpowiedzi, 'trudny' - bez podpowiedzi i z ograniczonym czasem na rozwiązanie każdego rebusu."
                },
                "timeLimitPerRebus": {
                    "type": "number",
                    "label": "Limit czasu na rozwiązanie każdego rebusu (w minutach)",
                    "helpFile": "help/help-file-test.md"
                },
                "testString": {
                    "type": "string",
                    "label": "Testowy string",
                    "help": "Testowy hint do pola"
                },
                "testStringMultiline": {
                    "type": "string",
                    "multiline": 10,
                    "label": "Komunikat testowy",
                    "helpFile": "help/help-file-test.md"
                },
                "testMessageText": {
                    "type": "message",
                    "format": "text",
                    "message": "To jest testowy komunikat, który nie jest powiązany z żadnym polem."
                },
                "testMessageInfo": {
                    "type": "message",
                    "format": "info",
                    "message": "To jest testowy komunikat informacyjny."
                },
                "testMessageWarning": {
                    "type": "message",
                    "format": "warning",
                    "message": "# Uwaga!\nTo jest testowy **komunikat** ostrzegawczy."
                }
            }
        },
        "rebuses": {
            "type": "array",
            "title": "Rebusy",
            "reorderable": true,
            "editable": true,
            "item": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "id"
                    },
                    "enabled": {
                        "type": "boolean",
                        "default": true,
                        "label": "Dostępny dla uczniów"
                    },
                    "style": {
                        "type": "string",
                        "enum": "styles",
                        "default": "classic",
                        "label": "Styl rebusu"
                    },
                    "answer": {
                        "type": "ref",
                        "path": "scenario.json#/rebuses/${id}/answer",
                        "label": "Odpowiedź"
                    }
                }
            }
        },
        "questions": {
            "type": "array",
            "title": "Pytania",
            "reorderable": true,
            "editable": true,
            "item": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "id"
                    },
                    "enabled": {
                        "type": "boolean",
                        "default": true,
                        "label": "Dostępny dla uczniów"
                    },
                    "text": {
                        "type": "string",
                        "default": "Treść pytania",
                        "label": "Treść pytania"
                    }
                }
            }
        }
    }
}