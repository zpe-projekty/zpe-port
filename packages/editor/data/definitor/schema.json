{
    "properties": {
        "difficulty": {
            "type": "string",
            "enum": {
                "normal": "Normalny",
                "medium": "Średni",
                "easy": "Łatwy"
            },
            "label": "Poziom trudności",
            "help": "Wpływa na liczbę dodatkowych (mylących) słów w banku przy układaniu definicji. Normalny = wszystkie dostępne słowa, Średni = 4 mylące słowa, Łatwy = brak mylących słów."
        },
        "taskLimit": {
            "type": "number",
            "format": "integer",
            "min": 0,
            "max": 120,
            "label": "Liczba zadań",
            "help": "Po ilu ukończonych zadaniach gra przechodzi do ekranu końcowego. 0 = wszystkie dostępne pojęcia (z włączonych kategorii)."
        },
        "pointsPenalty": {
            "type": "number",
            "format": "integer",
            "min": 0,
            "max": 500,
            "label": "Kara za błąd (punkty)",
            "help": "Liczba żetonów odejmowanych od wyniku ucznia po każdej błędnej próbie ułożenia definicji. Wartość 0 wyłącza karę."
        },
        "hintCost": {
            "type": "number",
            "format": "integer",
            "min": 0,
            "max": 500,
            "label": "Koszt użycia podpowiedzi",
            "help": "Liczba żetonów pobieranych za skorzystanie z podpowiedzi. Uczeń musi posiadać co najmniej tyle żetonów, aby móc kupić podpowiedź."
        },
        "categories": {
            "type": "array",
            "label": "Kategorie wiedzy",
            "help": "Włącz lub wyłącz całe kategorie. Wyłączona kategoria nie pojawia się na kole fortuny.",
            "item": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "private": true
                    },
                    "name": {
                        "type": "ref",
                        "path": "scenario.json#/kategorie/[{identyfikator:${id}}]/nazwa",
                        "label": "Kategoria"
                    },
                    "enabled": {
                        "type": "boolean",
                        "label": "Włączona"
                    }
                }
            }
        },
        "definitions": {
            "type": "array",
            "label": "Pojęcia (definicje)",
            "help": "Włącz lub wyłącz pojedyncze pojęcia. Wyłączone pojęcia nie będą losowane na kole.",
            "item": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "private": true
                    },
                    "enabled": {
                        "type": "boolean",
                        "label": "Włączone"
                    },
                    "pojecie": {
                        "type": "string",
                        "label": "Pojęcie"
                    },
                    "kategoria": {
                        "type": "string",
                        "enum": {
                            "geografia": "Geografia",
                            "fizyka": "Fizyka",
                            "biologia": "Biologia",
                            "chemia": "Chemia",
                            "informatyka": "Informatyka",
                            "logika": "Logika",
                            "matematyka": "Matematyka",
                            "technika": "Technika"
                        },
                        "label": "Kategoria"
                    },
                    "poprawnaSekwencja": {
                        "type": "string",
                        "label": "Poprawna definicja — całe zdanie, słowa oddzielone spacją"
                    },
                    "dostepneSlowa": {
                        "type": "string",
                        "label": "Dostępne słowa w banku — oddziel spacją"
                    },
                    "slowaOpcjonalne": {
                        "type": "string",
                        "label": "Słowa opcjonalne (można pominąć) — oddziel spacją"
                    },
                    "blokiObowiazkowe": {
                        "type": "string",
                        "label": "Bloki obowiązkowe — grupy oddziel średnikiem, słowa w grupie spacją"
                    },
                    "frazyZamienne": {
                        "type": "string",
                        "label": "Frazy zamienne — grupy oddziel średnikiem, słowa w grupie spacją"
                    },
                    "komunikatSukcesu": {
                        "type": "string",
                        "label": "Komunikat po poprawnej odpowiedzi"
                    },
                    "pulapki": {
                        "type": "string",
                        "label": "Pułapki — 'fraza :: komunikat', kolejne oddziel ' || '"
                    }
                }
            }
        }
    }
