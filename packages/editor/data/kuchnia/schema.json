{
    "types": {
        "era": {
            "type": "number",
            "enum": {
                "1": "Staropolska (XVI-XVIII w.)",
                "2": "XX wiek (1918-1989)",
                "3": "XXI wiek (współczesność)"
            }
        },
        "recipe": {
            "type": "string",
            "enum": {
                "bigos": "Bigos Staropolski",
                "zurek": "Żurek Staropolski",
                "pierogi": "Pierogi Ruskie",
                "schabowy": "Kotlet Schabowy",
                "rosol": "Rosół z Makaronem",
                "kluski_slaskie": "Kluski Śląskie",
                "flaki_po_warszawsku": "Flaki po Warszawsku",
                "bowl_fit": "Buddha Bowl",
                "burger": "Burger Wołowy",
                "sushi": "Sushi Maki"
            }
        }
    },
    "properties": {
        "enabledEras": {
            "type": "object",
            "label": "Dostępne epoki",
            "description": "Wybierz epoki kulinarne dostępne dla uczniów",
            "properties": {
                "era1": {
                    "type": "boolean",
                    "label": "Staropolska (XVI-XVIII w.)"
                },
                "era2": {
                    "type": "boolean",
                    "label": "XX wiek (1918-1989)"
                },
                "era3": {
                    "type": "boolean",
                    "label": "XXI wiek (współczesność)"
                }
            }
        },
        "enabledRecipes": {
            "type": "array",
            "label": "Dostępne przepisy",
            "description": "Wybierz przepisy dostępne w grze",
            "item": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "private": true
                    },
                    "enabled": {
                        "type": "boolean",
                        "label": "Włączony"
                    },
                    "text": {
                        "type": "ref",
                        "path": "scenario.json#/recipes/${id}/name",
                        "label": "Receptura"
                    }
                }
            }
        },
        "timerSeconds": {
            "type": "number",
            "label": "Czas na nakrycie stołu (sekundy)",
            "description": "Limit czasu na nakrycie stołu. Domyślnie 5 minut.",
            "default": 300,
            "min": 60,
            "max": 600
        },
        "allowTimerDisable": {
            "type": "boolean",
            "label": "Pozwól wyłączyć timer",
            "description": "Uczniowie z ograniczeniami mogą wyłączyć limit czasu",
            "default": true
        },
        "allowStudentRecipes": {
            "type": "boolean",
            "label": "Pozwól dodawać przepisy",
            "description": "Uczniowie mogą dodawać własne przepisy do Księgi",
            "default": false
        },
        "showCalories": {
            "type": "boolean",
            "label": "Pokazuj kalorie",
            "description": "Wyświetlaj informacje o wartości kalorycznej potraw",
            "default": true
        },
        "showHistoricalInfo": {
            "type": "boolean",
            "label": "Pokazuj informacje historyczne",
            "description": "Wyświetlaj informacje o historii i kontekście społecznym potraw",
            "default": true
        },
        "requireAllIngredients": {
            "type": "boolean",
            "label": "Wymagaj wszystkich składników",
            "description": "Gracz musi zebrać wszystkie poprawne składniki, aby ukończyć etap",
            "default": true
        }
    }
}